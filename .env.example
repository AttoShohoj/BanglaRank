# আসল মান Vercel > Settings > Environment Variables-এ বসান; এই ফাইলে নয়।
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# AI সহকারী (শুধু সার্ভারে; কখনো NEXT_PUBLIC_ দিয়ে নয়)
# AI_PROVIDER=anthropic          (ডিফল্ট) অথবা openai (OpenAI-সামঞ্জস্যপূর্ণ API)
# AI_PROVIDER_API_KEY=your-key-here
# AI_MODEL=model-name-from-provider-docs
# AI_BASE_URL=https://provider-openai-compatible-url/v1   (শুধু AI_PROVIDER=openai হলে)
# AI_DAILY_REQUEST_LIMIT=100
